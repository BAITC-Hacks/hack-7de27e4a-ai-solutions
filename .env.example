# ─────────────────────────────────────────────────────────────
# Career Quest — пример окружения. Скопировать в .env.local:
#   cp .env.example .env.local
#
# ВАЖНО: приложение обязано полностью работать БЕЗ единого ключа.
# Отсутствие LLM_API_KEY = deterministic fallback, а не ошибка.
# Это release gate, его проверяет жюри.
# ─────────────────────────────────────────────────────────────

# Bounded LLM critic (опционально). Пустой ключ -> deterministic fallback.
LLM_API_KEY=
# Вместо LLM_API_KEY сервер также читает OPENAI_API_KEY из окружения ОС.
# Эти значения используются по умолчанию во всех трёх AI routes.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Таймаут ограничен кодом диапазоном 100..3000 мс. По истечении -> fallback.
LLM_TIMEOUT_MS=2500
# HR-агент: бюджет одного обращения к модели, независимо от bounded-критика.
LLM_AGENT_TIMEOUT_MS=10000

# Server-bound сотрудник для личного route `/`. Arbitrary synthetic profiles доступны в `/demo`.
CAREER_QUEST_VIEWER_ID=E0028

# Дата среза датасета. Engine использует её как "сегодня".
NEXT_PUBLIC_SNAPSHOT_DATE=2026-10-01

# Версии engine/weights НЕ живут в env: они заданы в коде
# (src/domain/recommendation/recommend.ts -> ENGINE_VERSION) и попадают
# в Evidence Receipt и Trust Center оттуда. Один источник правды.

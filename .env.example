# ─────────────────────────────────────────────────────────────
# Career Quest — пример окружения. Скопировать в .env.local:
#   cp .env.example .env.local
#
# ВАЖНО: приложение обязано полностью работать БЕЗ единого ключа.
# Отсутствие LLM_API_KEY и OPENAI_API_KEY = deterministic fallback, а не ошибка.
# Это release gate, его проверяет жюри.
# ─────────────────────────────────────────────────────────────

# Bounded LLM critic и HR Agent (опционально).
LLM_API_KEY=
# Вместо LLM_API_KEY сервер также читает OPENAI_API_KEY из окружения ОС.
# Непустой LLM_API_KEY имеет приоритет. Не коммитить действующие ключи.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Таймаут ограничен кодом диапазоном 100..3000 мс. По истечении -> fallback.
LLM_TIMEOUT_MS=2500
# HR-агент: отдельный бюджет одного обращения к модели.
LLM_AGENT_TIMEOUT_MS=10000

# Подпись демо-сессии: минимум 32 байта. Это идентификация, не SSO.
# pnpm start / Docker при пустом значении создают уникальный ключ в data/runtime/session-secret.
# В dev используется случайный ключ процесса; после перезапуска потребуется выбрать профиль снова.
SESSION_SECRET=
# Опциональный точный внешний origin за reverse proxy, например https://career.example.com.
APP_ORIGIN=

# Дата среза датасета. Engine использует её как "сегодня".
NEXT_PUBLIC_SNAPSHOT_DATE=2026-10-01

# Версии engine/weights НЕ живут в env: они заданы в коде
# (src/domain/recommendation/recommend.ts -> ENGINE_VERSION) и попадают
# в Evidence Receipt и Trust Center оттуда. Один источник правды.

# OPENAI_API_KEY автоматически используется только для https://api.openai.com.
# Сторонний LLM_BASE_URL требует явный LLM_API_KEY.
